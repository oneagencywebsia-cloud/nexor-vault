# Crea un proyecto nuevo en https://supabase.com (separado del de CLIPSO.AI)
# y copia estas claves desde Project Settings → API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secreto para firmar la cookie de sesión (HS256). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Web Push (notificaciones). Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
